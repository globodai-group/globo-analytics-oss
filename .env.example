# =============================================================================
# GloboAnalytics OSS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/globoanalytics"

# -----------------------------------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------------------------------
# Generate a secure secret: openssl rand -base64 48
NEXTAUTH_SECRET="your-secret-key-minimum-64-characters-long"
# Your domain (use http://localhost:3000 for local dev)
NEXTAUTH_URL="https://your-domain.com"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Application name (shown in UI)
NEXT_PUBLIC_APP_NAME="GloboAnalytics"
# Public URL of your instance
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# -----------------------------------------------------------------------------
# Redis (Optional - Recommended for production)
# -----------------------------------------------------------------------------
# Redis is used for caching and rate limiting
# Without Redis, the app still works but with reduced performance
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# License Key (Optional - For Premium Features)
# -----------------------------------------------------------------------------
# Get your license at https://globoanalytics.com/pricing
# Format: GLOB-PRO-xxxxx or GLOB-ENTERPRISE-xxxxx
LICENSE_KEY=""

# -----------------------------------------------------------------------------
# Email (Optional - For auth emails and reports)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="analytics@your-domain.com"

# -----------------------------------------------------------------------------
# OAuth Providers (Optional)
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Advanced Settings
# -----------------------------------------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# Instance ID (auto-generated if not set)
# INSTANCE_ID=""

# GloboCloud API URL (don't change unless self-hosting cloud services)
# GLOBO_CLOUD_URL="https://api.globoanalytics.com"
