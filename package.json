{
  "name": "globo-analytics-oss",
  "version": "1.0.1",
  "description": "Privacy-focused, open-source web analytics platform",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/globodai-group/globo-analytics-oss.git"
  },
  "homepage": "https://globoanalytics.com",
  "bugs": {
    "url": "https://github.com/globodai-group/globo-analytics-oss/issues"
  },
  "keywords": [
    "analytics",
    "web-analytics",
    "privacy",
    "open-source",
    "self-hosted",
    "gdpr",
    "google-analytics-alternative"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "docker:build": "docker build -t globo-analytics-oss .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@hookform/resolvers": "^5.2.2",
    "@maxmind/geoip2-node": "^6.3.4",
